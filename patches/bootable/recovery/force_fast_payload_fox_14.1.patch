   DataManager::SetProgress(0);
 
+  int force_fast_payload_mode = 0;
+  DataManager::GetValue(TW_FORCE_FAST_PAYLOAD_VAR, force_fast_payload_mode);
+  if (force_fast_payload_mode) {
+	// force_fast_payload is a one-shot install mode
+	DataManager::SetValue(TW_FORCE_FAST_PAYLOAD_VAR, 0);
+	LOGINFO("force_fast_payload mode activated\n");
+	time_t start, stop;
+	time(&start);
+	ret_val = Process_force_fast_payload(path, wipe_cache);
+	time(&stop);
+	int total_time = static_cast<int>(difftime(stop, start));
+	if (ret_val == INSTALL_SUCCESS)
+		gui_msg(Msg(msg::kHighlight, "force_fast_payload_success=ROM installed successfully!")(total_time));
+	else
+		gui_err("force_fast_payload_fail=ROM installation failed!");
+	return ret_val;
+  }
+

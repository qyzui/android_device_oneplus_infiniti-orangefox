+// OrangeFox: force fast payload flashing (rewrite the super metadata)
+static int Process_force_fast_payload(const char *path, int *wipe_cache)
+{
+	int pipe_fd[2], status = 0;
+	char buffer[1024];
+
+	if (pipe(pipe_fd) != 0) {
+		LOGERR("force_fast_payload: pipe failed: %s\n", strerror(errno));
+		return INSTALL_ERROR;
+	}
+
+	pid_t pid = fork();
+	if (pid < 0) {
+		close(pipe_fd[0]);
+		close(pipe_fd[1]);
+		LOGERR("force_fast_payload: fork failed: %s\n", strerror(errno));
+		return INSTALL_ERROR;
+	}
+
+	if (pid == 0) {
+		close(pipe_fd[0]);
+		if (dup2(pipe_fd[1], 4) < 0) {
+			LOGERR("force_fast_payload: dup2 failed: %s\n", strerror(errno));
+			close(pipe_fd[1]);
+			_exit(127);
+		}
+		close(pipe_fd[1]);
+		execl("/system/bin/flashtool.sh", "flashtool.sh", path, NULL);
+		LOGERR("force_fast_payload: exec failed: %s\n", strerror(errno));
+		_exit(127);
+	}
+
+	close(pipe_fd[1]);
+	*wipe_cache = 0;
+
+	FILE* child_data = fdopen(pipe_fd[0], "r");
+	if (!child_data) {
+		close(pipe_fd[0]);
+		return INSTALL_ERROR;
+	}
+
+	while (fgets(buffer, sizeof(buffer), child_data) != NULL) {
+		char* command = strtok(buffer, " \n");
+		if (!command)
+			continue;
+
+		if (!strcmp(command, "progress")) {
+			char* fraction_char = strtok(NULL, " \n");
+			char* seconds_char = strtok(NULL, " \n");
+			if (fraction_char && seconds_char) {
+				float fraction = strtof(fraction_char, NULL);
+				int seconds = strtol(seconds_char, NULL, 10);
+				DataManager::ShowProgress(fraction, seconds);
+			}
+		} else if (!strcmp(command, "ui_print")) {
+			char* display_value = strtok(NULL, "\n");
+			gui_print("%s", display_value ? display_value : "");
+		} else if (!strcmp(command, "wipe_cache")) {
+			*wipe_cache = 1;
+		} else if (!strcmp(command, "log")) {
+			char* log_value = strtok(NULL, "\n");
+			if (log_value)
+				LOGINFO("%s\n", log_value);
+		}
+	}
+	fclose(child_data);
+
+	if (TWFunc::Wait_For_Child(pid, &status, "force_fast_payload") != 0) {
+		LOGERR("force_fast_payload: flashtool.sh failed\n");
+		return INSTALL_ERROR;
+	}
+
+	LOGINFO("force_fast_payload: flashtool.sh completed successfully\n");
+	return INSTALL_SUCCESS;
+}
